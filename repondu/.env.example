# --- API ------------------------------------------------------------------------------------
# Jeton Bearer exigé sur toutes les routes sauf /health (laisser vide en dev local).
API_TOKEN=change-me

# --- Proxies résidentiels / navigateur ----------------------------------------------------
# Utilisé par Playwright (Maps) et httpx (sites des prospects). Vide = connexion directe.
PROXY_URL=http://user:pass@proxy-host:port
HEADLESS=true

# --- Scraping Maps (A1) --------------------------------------------------------------------
SCRAPE_MIN_DELAY_S=2
SCRAPE_MAX_DELAY_S=6
SCRAPE_QUERIES=restaurant
SCRAPE_GRID_STEP_KM=1.2
SCRAPE_MAX_RESULTS_PER_JOB=120
SCRAPE_MAX_ATTEMPTS=3

# --- Avis (A2) ------------------------------------------------------------------------------
REVIEWS_SAMPLE_SIZE=30
REVIEWS_MIN_TOTAL=30

# --- Scoring (A3) --------------------------------------------------------------------------
SCORE_MIN_REVIEWS_PER_MONTH=10
SCORE_MAX_RESPONSE_RATE=0.5

# --- Enrichissement (A4) -------------------------------------------------------------------
ENRICH_TIMEOUT_S=15

# --- LLM (Phase B) — Claude Sonnet via clé API ---------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram (Phase B) --------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # chat autorisé à piloter le bot (vide = tous)
TELEGRAM_WEBHOOK_SECRET=     # chaîne aléatoire, vérifiée sur POST /telegram/webhook

# --- Prospection (Phase C) ---------------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=       # whsec_… (Svix) ; vide = webhook non vérifié
BREVO_API_KEY=               # email transactionnel + SMS
BREVO_WEBHOOK_TOKEN=         # ?token=… sur l'URL du webhook Brevo
OUTREACH_SEND_HOURS=9-18     # heure de Paris, jours ouvrés
OUTREACH_DM_BATCH=30
OUTREACH_MAX_BOUNCE_RATE=0.03
OUTREACH_SIGNATURE=Neo, Répondu
OUTREACH_REPLY_ADDRESS=contact@repondu.example
OUTREACH_PRICE_TEXT=39 €/mois après l'essai, rien pendant les 30 jours
PUBLIC_BASE_URL=https://api.repondu.example   # liens /p/{token} des SMS
SMS_SENDER=Repondu           # ≤ 11 caractères

# --- Service client (Phase D) --------------------------------------------------------------
GOOGLE_MANAGER_EMAIL=gestion@repondu.example   # compte Google du projet à ajouter comme gestionnaire
SERVICE_FROM_ADDRESS=contact@repondu.example   # boîte de service (invitations, brouillons, rapports)
SERVICE_FROM_NAME=Répondu
SERVICE_EMAIL_PROVIDER=resend                  # resend | brevo | log
SERVICE_IMAP_HOST=                             # boîte de service : « OK » / « VETO » des clients
SERVICE_IMAP_USER=
SERVICE_IMAP_PASSWORD=
MANAGER_IMAP_HOST=                             # compte gestionnaire : notifications « nouvel avis »
MANAGER_IMAP_USER=
MANAGER_IMAP_PASSWORD=
ONBOARDING_REMINDER_DAYS=3
TRIAL_DAYS=30
SERVICE_REVIEW_CHECK_HOURS=6

LOG_LEVEL=INFO
